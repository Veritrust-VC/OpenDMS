# syntax=docker/dockerfile:1
# Local-source variant of Dockerfile.uapf-engine — builds from ./engine-src/
# instead of cloning from GitHub. Mirrors the original Dockerfile.uapf-engine
# in all other respects.
FROM node:20-bookworm-slim AS builder
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates
WORKDIR /build
COPY engine-src/ .
RUN npm install --omit=dev --silent \
 && npm install --silent typescript ts-node \
 && npx tsc -p tsconfig.json

FROM node:20-bookworm-slim AS runtime
ENV NODE_ENV=production PORT=4000 PACKAGES_DIR=/packages
WORKDIR /app
COPY --from=builder /build/dist        ./dist
COPY --from=builder /build/node_modules ./node_modules
COPY --from=builder /build/package.json ./package.json
COPY --from=builder /build/public       ./public
RUN mkdir -p /packages
EXPOSE 4000
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD node -e "require('http').get('http://localhost:4000/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "dist/http/server.js"]

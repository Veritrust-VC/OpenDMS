<?xml version="1.0" encoding="UTF-8"?>
<!--
  e-submission 0.1 — UAS iesnieguma shēma (Tiesībsarga profils lv.tiesibsargs)

  UAS (Universal Agreement Structure) saime: tāda pati uzbūve kā e-agreement 0.2 —
  identity, provenance, parties, ... , attachments — lai iesniegums, atbilde, atzinums
  un izlīgums dalītos vienā kodolā. Elementu nosaukumi angliski kā UAS; skaidrojumi latviski.

  Iesniegums sadalīts sastāvdaļās, ko process var apstrādāt atsevišķi:
    narrative     izklāsts — kas noticis un kāpēc persona vēršas;
    facts         apstākļi un fakti — katrs atsevišķi, ar laiku, dalībnieku un pierādījumu;
    rightsAffected aizskartās tiesības — joma, tēmu klasifikatora kods, normatīvās atsauces;
    claims        prasījumi — katrs atsevišķi, ar veidu un saistītajiem faktiem;
    priorSteps    iepriekšējie soļi — vēršanās iestādē, apstrīdēšana, tiesvedība;
    privacy       iesniedzēja norādes par atklātību un atbildi.

  Shēma pārbauda uzbūvi. Juridisko pilnīgumu (adrese, paraksts, prasījums u. c.) pārbauda
  noteikumi (noteikumi/e-submission-0.1.sch) kā brīdinājumus: DVS pieņem arī nepilnīgu
  iesniegumu (APL 56. p. 4. d.), un par tā virzību lemj izvērtēšanas solis.

  Avoti: Iesniegumu likums (lv-lik-2007-09-27) 2., 3., 5., 6., 7., 9. p.;
  Administratīvā procesa likums 56. p.; Tiesībsarga likums 12., 23.–25. p.;
  Tiesībsarga biroja Pārbaudes lietu reglaments (07.04.2026., Nr. 8).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:es="urn:uas:esubmission:0.1"
           targetNamespace="urn:uas:esubmission:0.1"
           elementFormDefault="qualified"
           version="0.1">

  <!-- ============================ SAKNE ============================ -->
  <xs:element name="eSubmission">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="identity"       type="es:Identity"/>
        <xs:element name="provenance"     type="es:Provenance"     minOccurs="0"/>
        <xs:element name="parties"        type="es:Parties"/>
        <xs:element name="narrative"      type="es:Narrative"      minOccurs="0"/>
        <xs:element name="facts"          type="es:Facts"          minOccurs="0"/>
        <xs:element name="rightsAffected" type="es:RightsAffected" minOccurs="0"/>
        <xs:element name="claims"         type="es:Claims"         minOccurs="0"/>
        <xs:element name="priorSteps"     type="es:PriorSteps"     minOccurs="0"/>
        <xs:element name="privacy"        type="es:Privacy"        minOccurs="0"/>
        <xs:element name="attachments"    type="es:Attachments"    minOccurs="0"/>
        <xs:element name="declarations"   type="es:Declarations"   minOccurs="0"/>
        <xs:element name="extensions"     type="es:Extensions"     minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:token" fixed="0.1" use="required"/>
      <xs:attribute name="profile" type="xs:token" use="required">
        <xs:annotation><xs:documentation xml:lang="lv">Profils nosaka saņēmēja specifiskos noteikumus
          un vārdnīcas, piem. lv.tiesibsargs.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <!-- ========================== IDENTITY =========================== -->
  <xs:complexType name="Identity">
    <xs:sequence>
      <xs:element name="submissionType" type="es:SubmissionType" maxOccurs="4">
        <xs:annotation><xs:documentation xml:lang="lv">Iesniegumu likums 2. p. 1. d.: lūgums, sūdzība,
          priekšlikums vai jautājums. Vienā iesniegumā var būt vairāki.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="title"          type="es:Text200" minOccurs="0"/>
      <xs:element name="language"       type="xs:language"/>
      <xs:element name="status"         type="es:Status"/>
      <xs:element name="registrationNo" type="xs:token" minOccurs="0">
        <xs:annotation><xs:documentation xml:lang="lv">Reģistrācijas numurs DVS (Iesniegumu likums 3. p. 5. d.).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="documentId"     type="xs:token" minOccurs="0">
        <xs:annotation><xs:documentation xml:lang="lv">Dokumenta identifikators pēc Dokumentu metadatu standarta (LV-DOK-…).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="receivedAt"     type="xs:dateTime" minOccurs="0"/>
      <xs:element name="channel"        type="es:Channel"/>
      <xs:element name="recipient"      type="es:Organisation"/>
      <xs:element name="signature"      type="es:Signature"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Signature">
    <xs:sequence>
      <xs:element name="method"   type="es:SignatureMethod"/>
      <xs:element name="signedAt" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="signer"   type="es:PartyRef" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation><xs:documentation xml:lang="lv">Parakstītāji. Kopīgam iesniegumam atbildi sūta pirmajam
          (Iesniegumu likums 6. p. 1. d.).</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Organisation">
    <xs:sequence>
      <xs:element name="name" type="es:Text200"/>
      <xs:element name="code" type="xs:token" minOccurs="0">
        <xs:annotation><xs:documentation xml:lang="lv">VPK ID, ATVK kods vai reģistrācijas numurs.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="did"  type="xs:anyURI" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ========================= PROVENANCE ========================== -->
  <xs:complexType name="Provenance">
    <xs:annotation><xs:documentation xml:lang="lv">No kā un kā iesniegums strukturēts. Avota dokuments
      paliek oriģināls; šī instance ir tā strukturēts attēlojums.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="sourceDocument" type="es:FileRef" minOccurs="0"/>
      <xs:element name="structuring"    type="es:Structuring"/>
      <xs:element name="formVersion"    type="xs:token" minOccurs="0"/>
      <xs:element name="convertedFrom"  type="xs:token" minOccurs="0">
        <xs:annotation><xs:documentation xml:lang="lv">Ja pārveidots no citas shēmas, piem. urn:lv:tiesibsargs:iesniegums:1.0.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Structuring">
    <xs:sequence>
      <xs:element name="method"      type="es:StructuringMethod"/>
      <xs:element name="performedAt" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="model"       type="es:Text200" minOccurs="0">
        <xs:annotation><xs:documentation xml:lang="lv">Valodas modelis, ja strukturēja MI.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="reviewedBy"  type="es:Text200" minOccurs="0"/>
      <xs:element name="reviewedAt"  type="xs:dateTime" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="FileRef">
    <xs:sequence>
      <xs:element name="fileName"  type="es:Text200"/>
      <xs:element name="mediaType" type="xs:token" minOccurs="0"/>
      <xs:element name="sha256"    type="es:Sha256" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- =========================== PARTIES =========================== -->
  <xs:complexType name="Parties">
    <xs:sequence>
      <xs:element name="party" type="es:Party" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Party">
    <xs:annotation><xs:documentation xml:lang="lv">Fiziskai personai — givenName un familyName;
      juridiskai — legalName un registrationNo; iestādei — legalName un code
      (Iesniegumu likums 3. p. 2. d.; APL 56. p. 1. d.).</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="id"             type="es:LocalId"/>
      <xs:element name="role"           type="es:PartyRole" maxOccurs="3"/>
      <xs:element name="partyType"      type="es:PartyType"/>
      <xs:element name="givenName"      type="es:Text200" minOccurs="0"/>
      <xs:element name="familyName"     type="es:Text200" minOccurs="0"/>
      <xs:element name="legalName"      type="es:Text200" minOccurs="0"/>
      <xs:element name="registrationNo" type="xs:token" minOccurs="0"/>
      <xs:element name="code"           type="xs:token" minOccurs="0">
        <xs:annotation><xs:documentation xml:lang="lv">Iestādei: VPK ID vai ATVK kods.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="address"        type="es:Text200" minOccurs="0"/>
      <xs:element name="contact"        type="es:Contact" minOccurs="0"/>
      <xs:element name="representation" type="es:Representation" minOccurs="0"/>
      <xs:element name="vulnerability"  type="es:Vulnerability" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation><xs:documentation xml:lang="lv">Lietas pazīme — kods no tēmu klasifikatora vārdnīcas
          vardnicas/lietas-pazimes.csv, piem. PZ-BE bērns, PZ-IN persona ar invaliditāti, PZ-BA brīvības atņemšana.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Contact">
    <xs:sequence>
      <xs:element name="email"    type="es:Email" minOccurs="0"/>
      <xs:element name="phone"    type="es:Phone" minOccurs="0"/>
      <xs:element name="eAddress" type="es:Text200" minOccurs="0">
        <xs:annotation><xs:documentation xml:lang="lv">Oficiālās elektroniskās adreses konts.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Representation">
    <xs:annotation><xs:documentation xml:lang="lv">Pārstāvja pilnvarojums citas personas interesēs
      (APL 56. p. 1.¹ d.; Pārbaudes lietu reglaments 6. p.).</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="represents"  type="es:PartyRef"/>
      <xs:element name="basis"       type="es:RepresentationBasis"/>
      <xs:element name="description" type="es:Text500" minOccurs="0"/>
      <xs:element name="evidence"    type="es:AttachmentRef" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== NARRATIVE (izklāsts) ===================== -->
  <xs:complexType name="Narrative">
    <xs:sequence>
      <xs:element name="summary" type="es:Text1000">
        <xs:annotation><xs:documentation xml:lang="lv">Īss izklāsts: kas noticis, kāpēc persona vēršas.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="text"    type="es:Text20000" minOccurs="0">
        <xs:annotation><xs:documentation xml:lang="lv">Pilns izklāsts iesniedzēja vārdiem (no veidlapas vai avota dokumenta).</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- =================== FACTS (apstākļi un fakti) =================== -->
  <xs:complexType name="Facts">
    <xs:sequence>
      <xs:element name="fact" type="es:Fact" maxOccurs="200"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Fact">
    <xs:annotation><xs:documentation xml:lang="lv">Viens apstāklis vai fakts. Kas, kad, ko darīja vai nedarīja,
      un ar ko tas pierādīts (Iesniegumu likums 3. p. 4. d.). Fakts ir iesniedzēja apgalvojums,
      kamēr tas nav pārbaudīts.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="id"        type="es:LocalId"/>
      <xs:element name="when"      type="es:When" minOccurs="0"/>
      <xs:element name="place"     type="es:Text200" minOccurs="0"/>
      <xs:element name="actor"     type="es:PartyRef" minOccurs="0" maxOccurs="5">
        <xs:annotation><xs:documentation xml:lang="lv">Kurš rīkojās vai bezdarbojās (atsauce uz party/id).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="conduct"   type="es:Conduct" minOccurs="0"/>
      <xs:element name="statement" type="es:Text2000"/>
      <xs:element name="basis"     type="es:FactBasis"/>
      <xs:element name="evidence"  type="es:AttachmentRef" minOccurs="0" maxOccurs="20"/>
      <xs:element name="sourceExcerpt" type="es:Text1000" minOccurs="0">
        <xs:annotation><xs:documentation xml:lang="lv">Ja strukturēts no brīva teksta — avota fragments,
          no kura fakts iegūts (pārbaudāmībai).</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="When">
    <xs:choice>
      <xs:element name="date"      type="xs:date"/>
      <xs:element name="yearMonth" type="xs:gYearMonth"/>
      <xs:element name="year"      type="xs:gYear"/>
      <xs:element name="period">
        <xs:complexType><xs:sequence>
          <xs:element name="from" type="xs:date"/>
          <xs:element name="to"   type="xs:date" minOccurs="0"/>
        </xs:sequence></xs:complexType>
      </xs:element>
      <xs:element name="ongoing"   type="es:True"/>
    </xs:choice>
  </xs:complexType>

  <!-- =============== RIGHTS AFFECTED (aizskartās tiesības) =============== -->
  <xs:complexType name="RightsAffected">
    <xs:sequence>
      <xs:element name="domain"         type="es:Domain" maxOccurs="4"/>
      <xs:element name="classifierCode" type="es:ClassifierCode" minOccurs="0" maxOccurs="5">
        <xs:annotation><xs:documentation xml:lang="lv">Tiesībsarga tēmu klasifikatora 2.0 kods
          (tiesibsargs/temu-klasifikators). Vai kods ir izvēlams, pārbauda DVS ievade.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="normativeReference" type="es:NormativeReference" minOccurs="0" maxOccurs="20">
        <xs:annotation><xs:documentation xml:lang="lv">Tiesību normas, uz kurām atsaucas iesniedzējs.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="NormativeReference">
    <xs:sequence>
      <xs:element name="eli"   type="xs:anyURI" minOccurs="0"/>
      <xs:element name="lawId" type="xs:token" minOccurs="0">
        <xs:annotation><xs:documentation xml:lang="lv">Likuma identifikators kā datos, piem. lv-lik-2007-09-27.art7.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="label" type="es:Text500"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== CLAIMS (prasījumi) ===================== -->
  <xs:complexType name="Claims">
    <xs:sequence>
      <xs:element name="claim" type="es:Claim" maxOccurs="20"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Claim">
    <xs:annotation><xs:documentation xml:lang="lv">Ko iesniedzējs lūdz (APL 56. p. 1. d. — prasījums).
      Veidi atbilst Tiesībsarga likuma 12. pantā noteiktajiem uzdevumiem.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="id"           type="es:LocalId"/>
      <xs:element name="type"         type="es:ClaimType"/>
      <xs:element name="text"         type="es:Text1000"/>
      <xs:element name="addressedTo"  type="es:PartyRef" minOccurs="0">
        <xs:annotation><xs:documentation xml:lang="lv">Pret kuru vērsts prasījums (iestāde vai persona), ja attiecas.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="relatedFact"  type="es:FactRef" minOccurs="0" maxOccurs="50"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ================ PRIOR STEPS (iepriekšējie soļi) ================ -->
  <xs:complexType name="PriorSteps">
    <xs:annotation><xs:documentation xml:lang="lv">Vispārējo tiesību aizsardzības līdzekļu izmantošana un tiesvedība
      (Pārbaudes lietu reglaments 24. p.).</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="step"  type="es:PriorStep" minOccurs="0" maxOccurs="20"/>
      <xs:element name="court" type="es:Court"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PriorStep">
    <xs:sequence>
      <xs:element name="type"           type="es:PriorStepType"/>
      <xs:element name="addressedTo"    type="es:PartyRef" minOccurs="0"/>
      <xs:element name="date"           type="xs:date" minOccurs="0"/>
      <xs:element name="responseReceived" type="xs:boolean"/>
      <xs:element name="responseDate"   type="xs:date" minOccurs="0"/>
      <xs:element name="responseSummary" type="es:Text1000" minOccurs="0"/>
      <xs:element name="evidence"       type="es:AttachmentRef" minOccurs="0" maxOccurs="10"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Court">
    <xs:sequence>
      <xs:element name="status" type="es:CourtStatus"/>
      <xs:element name="caseNo" type="xs:token" minOccurs="0"/>
      <xs:element name="court"  type="es:Text200" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- =================== PRIVACY (atklātība, atbilde) =================== -->
  <xs:complexType name="Privacy">
    <xs:sequence>
      <xs:element name="doNotDiscloseIdentity" type="xs:boolean" default="false">
        <xs:annotation><xs:documentation xml:lang="lv">Iesniegumu likums 9. p. 1. d.; Tiesībsarga likums 23. p. 6. d.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="doNotDiscloseFacts" type="xs:boolean" default="false">
        <xs:annotation><xs:documentation xml:lang="lv">Iesniegumu likums 9. p. 2. d.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="noReplyNeeded" type="xs:boolean" default="false">
        <xs:annotation><xs:documentation xml:lang="lv">Iesniegumu likums 5. p. 6. d.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="replyChannel" type="es:ReplyChannel" minOccurs="0">
        <xs:annotation><xs:documentation xml:lang="lv">Kā iesniedzējs vēlas saņemt atbildi; mutvārdos tikai ar
          iesniedzēja piekrišanu (Iesniegumu likums 5. p. 1.¹ d.).</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== ATTACHMENTS (pielikumi) ===================== -->
  <xs:complexType name="Attachments">
    <xs:sequence>
      <xs:element name="attachment" type="es:Attachment" maxOccurs="50"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Attachment">
    <xs:annotation><xs:documentation xml:lang="lv">Pielikumi ir pierādījumi, nevis iesniegums
      (Iesniegumu likums 3. p. 4. d.).</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="id"          type="es:LocalId"/>
      <xs:element name="kind"        type="es:AttachmentKind"/>
      <xs:element name="fileName"    type="es:Text200"/>
      <xs:element name="description" type="es:Text200" minOccurs="0"/>
      <xs:element name="mediaType"   type="xs:token" minOccurs="0"/>
      <xs:element name="sha256"      type="es:Sha256" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Declarations">
    <xs:annotation><xs:documentation xml:lang="lv">Tiešsaistes veidlapas apliecinājumi.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="informationTruthful"          type="es:True"/>
      <xs:element name="dataProcessingAcknowledged"   type="es:True"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Extensions">
    <xs:sequence>
      <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ======================== VIENKĀRŠIE TIPI ======================== -->
  <xs:simpleType name="LocalId"><xs:restriction base="xs:token"><xs:pattern value="[A-Za-z][A-Za-z0-9_\-]{0,39}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="PartyRef"><xs:restriction base="es:LocalId"/></xs:simpleType>
  <xs:simpleType name="FactRef"><xs:restriction base="es:LocalId"/></xs:simpleType>
  <xs:simpleType name="AttachmentRef"><xs:restriction base="es:LocalId"/></xs:simpleType>

  <xs:simpleType name="Text200"><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="200"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Text500"><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="500"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Text1000"><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="1000"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Text2000"><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="2000"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Text20000"><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="20000"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Sha256"><xs:restriction base="xs:token"><xs:pattern value="[0-9a-f]{64}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Email"><xs:restriction base="xs:token"><xs:maxLength value="200"/><xs:pattern value="[^@\s]+@[^@\s]+\.[^@\s]+"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Phone"><xs:restriction base="xs:token"><xs:pattern value="\+?[0-9 ]{8,16}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="True"><xs:restriction base="xs:boolean"><xs:pattern value="true"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="ClassifierCode"><xs:restriction base="xs:token"><xs:pattern value="[1-9][0-9]?(\.[A-Z]{1,3}){0,2}"/></xs:restriction></xs:simpleType>

  <xs:simpleType name="SubmissionType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="lugums"/><xs:enumeration value="sudziba"/>
      <xs:enumeration value="prieksl"/><xs:enumeration value="jautajums"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Status">
    <xs:annotation><xs:documentation xml:lang="lv">received — saņemts; structured — strukturēts (vēl nav pārskatīts);
      reviewed — cilvēks pārskatījis strukturējumu; registered — reģistrēts DVS.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="received"/><xs:enumeration value="structured"/>
      <xs:enumeration value="reviewed"/><xs:enumeration value="registered"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Channel">
    <xs:annotation><xs:documentation xml:lang="lv">Metadatu standarta SanemsanasKanals vērtības un a2a (no citas iestādes aģenta).</xs:documentation></xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="portal"/><xs:enumeration value="email"/><xs:enumeration value="eAddress"/>
      <xs:enumeration value="inPerson"/><xs:enumeration value="post"/><xs:enumeration value="oral"/>
      <xs:enumeration value="a2a"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SignatureMethod">
    <xs:annotation><xs:documentation xml:lang="lv">Iesniegumu likums 2. p. 3. d.: elektroniskais paraksts vai
      identitātes pārbaude latvija.lv; 7. p. 1. d. 2. p.: neparakstīts iesniegums.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="qualifiedESignature"/><xs:enumeration value="latvijaLvIdentified"/>
      <xs:enumeration value="handwritten"/><xs:enumeration value="oralRecorded"/>
      <xs:enumeration value="none"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StructuringMethod">
    <xs:restriction base="xs:token">
      <xs:enumeration value="form"/><xs:enumeration value="manual"/>
      <xs:enumeration value="ai"/><xs:enumeration value="conversion"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PartyRole">
    <xs:annotation><xs:documentation xml:lang="lv">submitter — iesniedzējs; coSubmitter — kopīga iesnieguma parakstītājs;
      representative — pārstāvis; affectedPerson — persona, kuras tiesības skartas; respondent — iestāde vai persona,
      kuras rīcība ir iesnieguma priekšmets; witness — liecinieks; other.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="submitter"/><xs:enumeration value="coSubmitter"/>
      <xs:enumeration value="representative"/><xs:enumeration value="affectedPerson"/>
      <xs:enumeration value="respondent"/><xs:enumeration value="witness"/>
      <xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PartyType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="naturalPerson"/><xs:enumeration value="legalPerson"/>
      <xs:enumeration value="institution"/><xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RepresentationBasis">
    <xs:restriction base="xs:token">
      <xs:enumeration value="authorisation"/><xs:enumeration value="legalRepresentative"/>
      <xs:enumeration value="none"/><xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Vulnerability"><xs:restriction base="xs:token"><xs:pattern value="PZ-[A-Z]{2,3}"/></xs:restriction></xs:simpleType>

  <xs:simpleType name="Conduct">
    <xs:restriction base="xs:token">
      <xs:enumeration value="action"/><xs:enumeration value="omission"/>
      <xs:enumeration value="decision"/><xs:enumeration value="statement"/>
      <xs:enumeration value="event"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FactBasis">
    <xs:annotation><xs:documentation xml:lang="lv">claimed — iesniedzēja apgalvojums; documented — pievienots pierādījums;
      verified — Birojs pārbaudījis (aizpilda tikai process).</xs:documentation></xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="claimed"/><xs:enumeration value="documented"/><xs:enumeration value="verified"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Domain">
    <xs:annotation><xs:documentation xml:lang="lv">Tēmu klasifikatora jomas: BT bērnu tiesības; PPT pilsoniskās un
      politiskās tiesības; SEK sociālās, ekonomiskās un kultūras tiesības; TV tiesiskā vienlīdzība un
      diskriminācijas novēršana. Labas pārvaldības jautājumi klasificējami pēc tēmas klasifikatorā.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="BT"/><xs:enumeration value="PPT"/><xs:enumeration value="SEK"/>
      <xs:enumeration value="TV"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ClaimType">
    <xs:annotation><xs:documentation xml:lang="lv">Tiesībsarga likums 12. p.: investigate — ierosināt pārbaudes lietu;
      opinion — atzinums; conciliation — izlīgums; consultation — konsultācija; information — informācija;
      legislativeChange — normatīvā akta izdošana vai grozīšana; remedy — konkrēta pārkāpuma novēršana; other.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="investigate"/><xs:enumeration value="opinion"/>
      <xs:enumeration value="conciliation"/><xs:enumeration value="consultation"/>
      <xs:enumeration value="information"/><xs:enumeration value="legislativeChange"/>
      <xs:enumeration value="remedy"/><xs:enumeration value="other"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PriorStepType">

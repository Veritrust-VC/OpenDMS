      <xs:enumeration value="decided"/><xs:enumeration value="unknown"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ReplyChannel">
    <xs:restriction base="xs:token">
      <xs:enumeration value="email"/><xs:enumeration value="eAddress"/>
      <xs:enumeration value="post"/><xs:enumeration value="oral"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AttachmentKind">
    <xs:restriction base="xs:token">
      <xs:enumeration value="evidence"/><xs:enumeration value="authorisation"/>
